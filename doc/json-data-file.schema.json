{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hseag.com/schemas/evidense/json-data-file.schema.json",
  "title": "eviDense UV Photometer JSON Data File",
  "description": "Schema for JSON measurement data files generated by the eviDense UV Photometer software interfaces.",
  "type": "object",
  "required": [
    "measurements"
  ],
  "properties": {
    "info": {
      "$ref": "#/$defs/info"
    },
    "parameters_run": {
      "$ref": "#/$defs/parametersRun"
    },
    "adjustments": {
      "$ref": "#/$defs/adjustments"
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurementEntry"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "numberValue": {
      "type": "number"
    },
    "channel": {
      "type": "object",
      "required": [
        "sample",
        "reference"
      ],
      "properties": {
        "sample": {
          "$ref": "#/$defs/numberValue"
        },
        "reference": {
          "$ref": "#/$defs/numberValue"
        }
      },
      "additionalProperties": false
    },
    "singleMeasurement": {
      "type": "object",
      "required": [
        "230",
        "260",
        "280",
        "340"
      ],
      "properties": {
        "230": {
          "$ref": "#/$defs/channel"
        },
        "260": {
          "$ref": "#/$defs/channel"
        },
        "280": {
          "$ref": "#/$defs/channel"
        },
        "340": {
          "$ref": "#/$defs/channel"
        }
      },
      "additionalProperties": false
    },
    "quadruple": {
      "type": "object",
      "required": [
        "230",
        "260",
        "280",
        "340"
      ],
      "properties": {
        "230": {
          "$ref": "#/$defs/numberValue"
        },
        "260": {
          "$ref": "#/$defs/numberValue"
        },
        "280": {
          "$ref": "#/$defs/numberValue"
        },
        "340": {
          "$ref": "#/$defs/numberValue"
        }
      },
      "additionalProperties": false
    },
    "results": {
      "type": "object",
      "required": [
        "dsDNA",
        "ssDNA",
        "ssRNA",
        "purity260/230",
        "purity260/280"
      ],
      "properties": {
        "dsDNA": {
          "$ref": "#/$defs/numberValue"
        },
        "ssDNA": {
          "$ref": "#/$defs/numberValue"
        },
        "ssRNA": {
          "$ref": "#/$defs/numberValue"
        },
        "purity260/230": {
          "$ref": "#/$defs/numberValue"
        },
        "purity260/280": {
          "$ref": "#/$defs/numberValue"
        },
        "A230": {
          "$ref": "#/$defs/numberValue"
        },
        "A260": {
          "$ref": "#/$defs/numberValue"
        },
        "A280": {
          "$ref": "#/$defs/numberValue"
        },
        "A340": {
          "$ref": "#/$defs/numberValue"
        }
      },
      "additionalProperties": false
    },
    "factors": {
      "type": "object",
      "required": [
        "f_a_buffer_blank"
      ],
      "properties": {
        "f_a_buffer_blank": {
          "$ref": "#/$defs/quadruple"
        }
      },
      "additionalProperties": false
    },
    "adjustments": {
      "type": "object",
      "properties": {
        "centerwavelengths": {
          "type": "object",
          "properties": {
            "260": {
              "$ref": "#/$defs/numberValue"
            },
            "280": {
              "$ref": "#/$defs/numberValue"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "parametersRun": {
      "type": "object",
      "properties": {
        "nr_of_blanks": {
          "type": "integer",
          "minimum": 0
        },
        "factors": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/factors"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "info": {
      "type": "object",
      "required": [
        "date",
        "product",
        "production_number",
        "serial_number",
        "firmware_version",
        "comment",
        "api"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "production_number": {
          "type": "string"
        },
        "serial_number": {
          "type": "string"
        },
        "firmware_version": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "api": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "measurementEntry": {
      "type": "object",
      "required": [
        "baseline",
        "air",
        "sample"
      ],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/singleMeasurement"
        },
        "air": {
          "$ref": "#/$defs/singleMeasurement"
        },
        "sample": {
          "$ref": "#/$defs/singleMeasurement"
        },
        "comment": {
          "type": "string"
        },
        "date_time": {
          "type": "string"
        },
        "logging": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "results": {
          "$ref": "#/$defs/results"
        }
      },
      "additionalProperties": true
    }
  }
}
